NEXT_PUBLIC_GENNETY_API_URL=https://dating-api.gennety.com/v1

# Neon Postgres for cookie consent logging.
# Use the pooled connection string at runtime.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require

# Use the direct connection string only for migrations/admin tasks.
DATABASE_URL_DIRECT=postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require

# Server-only. Use a long random value and keep it out of client bundles.
CONSENT_IP_SALT=replace-with-a-long-random-secret
POLICY_VERSION=2026-07-23

# Client-side UX cache version. Must match POLICY_VERSION.
NEXT_PUBLIC_POLICY_VERSION=2026-07-23

# Existing Supabase auth/admin integration, if enabled for this app.
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=replace-with-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
